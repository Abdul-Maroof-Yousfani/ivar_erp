model ProductionBatch {
  id                String            @id @default(uuid())
  batchNumber       String            @unique @map("batch_number") // e.g. PB-2026-0001
  supplierId        String            @map("supplier_id")          // CMT Vendor (Supplier) ID
  
  // Fabric Details
  fabricItemId      String            @map("fabric_item_id")       // Raw Fabric Item ID
  fabricWarehouseId String            @map("fabric_warehouse_id")  // Warehouse where fabric was held by vendor
  trackerId         String?           @map("tracker_id")          // Optional Fabric Vendor Tracker ID
  qtyFabricUsed     Decimal           @db.Decimal(15, 4) @map("qty_fabric_used") // meters used
  fabricRate        Decimal           @db.Decimal(15, 4) @map("fabric_rate")     // rate per meter
  
  // Finished Article Details
  articleItemId     String            @map("article_item_id")      // Finished Garment Item ID
  
  // Quantities Received & Grading
  qtyTotalReceived  Decimal           @db.Decimal(15, 4) @map("qty_total_received") // Total pieces (A + B)
  qtyAGrade         Decimal           @db.Decimal(15, 4) @map("qty_a_grade")        // A pieces
  qtyBGrade         Decimal           @db.Decimal(15, 4) @map("qty_b_grade")        // B pieces
  qtyRefreshed      Decimal           @default(0.0) @db.Decimal(15, 4) @map("qty_refreshed") // B pieces refreshed so far
  
  // Costing Engine Values (Exactly matching COSTING FILE.xlsx)
  consumption       Decimal           @db.Decimal(15, 6) @map("consumption")         // CONS (meters/pc)
  fabricCostPerPc   Decimal           @db.Decimal(15, 4) @map("fabric_cost_per_pc")  // CONS * fabricRate
  cmtCostPerPc      Decimal           @db.Decimal(15, 4) @map("cmt_cost_per_pc")     // Vendor CMT per pc
  initialNetCost    Decimal           @db.Decimal(15, 4) @map("initial_net_cost")    // fabricCostPerPc + cmtCostPerPc
  totalBill         Decimal           @db.Decimal(15, 4) @map("total_bill")          // initialNetCost * qtyTotalReceived
  bUnitValue        Decimal           @db.Decimal(15, 4) @map("b_unit_value")        // initialNetCost * 0.50
  bTotalValue       Decimal           @db.Decimal(15, 4) @map("b_total_value")       // qtyBGrade * bUnitValue
  aTotalValue       Decimal           @db.Decimal(15, 4) @map("a_total_value")       // totalBill - bTotalValue
  aFinalUnitCost    Decimal           @db.Decimal(15, 4) @map("a_final_unit_cost")   // aTotalValue / qtyAGrade
  
  // Warehouses
  aGradeWarehouseId String            @map("a_grade_warehouse_id") // A-Grade Finished Warehouse
  bGradeWarehouseId String            @map("b_grade_warehouse_id") // B-Grade Warehouse
  
  // Financial Links
  purchaseInvoiceId String?           @unique @map("purchase_invoice_id") // Auto-created CMT Invoice ID
  isCostingLocked   Boolean           @default(false) @map("is_costing_locked")
  status            String            @default("COMPLETED") // COMPLETED | DRAFT | CANCELLED
  
  // Tracking
  productionDate    DateTime          @default(now()) @map("production_date")
  notes             String?
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  
  // Relations
  supplier          Supplier          @relation("SupplierProductionBatches", fields: [supplierId], references: [id])
  fabricItem        Item              @relation("FabricProductionBatches", fields: [fabricItemId], references: [id])
  articleItem       Item              @relation("ArticleProductionBatches", fields: [articleItemId], references: [id])
  fabricWarehouse   Warehouse         @relation("FabricWarehouseBatches", fields: [fabricWarehouseId], references: [id])
  tracker           FabricVendorTracker? @relation(fields: [trackerId], references: [id])
  batchItems        ProductionBatchItem[]
  aGradeWarehouse   Warehouse         @relation("AGradeWarehouseBatches", fields: [aGradeWarehouseId], references: [id])
  bGradeWarehouse   Warehouse         @relation("BGradeWarehouseBatches", fields: [bGradeWarehouseId], references: [id])
  purchaseInvoice   PurchaseInvoice?  @relation("InvoiceProductionBatch", fields: [purchaseInvoiceId], references: [id])
  refreshLogs       ProductionRefreshLog[]

  @@index([supplierId])
  @@index([fabricItemId])
  @@index([articleItemId])
  @@map("production_batches")
}

model ProductionRefreshLog {
  id                 String            @id @default(uuid())
  batchId            String            @map("batch_id")
  qtyRefreshed       Decimal           @db.Decimal(15, 4) @map("qty_refreshed")
  refreshRate        Decimal           @default(0.0) @db.Decimal(15, 4) @map("refresh_rate")
  refreshTotalAmount Decimal           @default(0.0) @db.Decimal(15, 4) @map("refresh_total_amount")
  refreshInvoiceId   String?           @map("refresh_invoice_id")
  refreshDate        DateTime          @default(now()) @map("refresh_date")
  notes              String?
  createdAt          DateTime          @default(now()) @map("created_at")

  batch              ProductionBatch   @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@map("production_refresh_logs")
}



model ProductionBatchItem {
  id                String            @id @default(uuid())
  batchId           String            @map("batch_id")
  articleItemId     String            @map("article_item_id")
  sizeName          String?           @map("size_name") // e.g. "32", "L", "Free Size"
  
  qtyTotalReceived  Decimal           @db.Decimal(15, 4) @map("qty_total_received")
  qtyAGrade         Decimal           @db.Decimal(15, 4) @map("qty_a_grade")
  qtyBGrade         Decimal           @db.Decimal(15, 4) @map("qty_b_grade")
  qtyRefreshed      Decimal           @default(0.0) @db.Decimal(15, 4) @map("qty_refreshed")
  
  qtyFabricUsed     Decimal?          @db.Decimal(15, 4) @map("qty_fabric_used")
  consumption       Decimal?          @db.Decimal(15, 6) @map("consumption")
  
  cmtCostPerPc      Decimal           @db.Decimal(15, 4) @map("cmt_cost_per_pc")
  fabricCostPerPc   Decimal           @db.Decimal(15, 4) @map("fabric_cost_per_pc")
  initialNetCost    Decimal           @db.Decimal(15, 4) @map("initial_net_cost")
  bUnitValue        Decimal           @db.Decimal(15, 4) @map("b_unit_value")
  aFinalUnitCost    Decimal           @db.Decimal(15, 4) @map("a_final_unit_cost")
  totalLineAmount   Decimal           @db.Decimal(15, 4) @map("total_line_amount")
  
  createdAt         DateTime          @default(now()) @map("created_at")

  batch             ProductionBatch   @relation(fields: [batchId], references: [id], onDelete: Cascade)
  articleItem       Item              @relation("BatchLineArticleItem", fields: [articleItemId], references: [id])

  @@index([batchId])
  @@index([articleItemId])
  @@map("production_batch_items")
}

model BGradeRefreshOrder {
  id                String    @id @default(uuid())
  orderNumber       String    @unique @map("order_number")
  supplierId        String    @map("supplier_id")
  bGradeWarehouseId String    @map("b_grade_warehouse_id")
  status            String    @default("PENDING") // PENDING | PARTIALLY_RECEIVED | COMPLETED | CANCELLED
  sentDate          DateTime  @default(now()) @map("sent_date")
  notes             String?
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  supplier          Supplier  @relation("SupplierBGradeRefreshOrders", fields: [supplierId], references: [id])
  bGradeWarehouse   Warehouse @relation("BGradeRefreshOrderWarehouse", fields: [bGradeWarehouseId], references: [id])
  items             BGradeRefreshOrderItem[]
  receivings        BGradeRefreshReceiving[]

  @@index([supplierId])
  @@index([bGradeWarehouseId])
  @@map("b_grade_refresh_orders")
}

model BGradeRefreshOrderItem {
  id                 String   @id @default(uuid())
  orderId            String   @map("order_id")
  itemId             String   @map("item_id")
  qtySent            Decimal  @db.Decimal(15, 4) @map("qty_sent")
  qtyReceived        Decimal  @default(0) @db.Decimal(15, 4) @map("qty_received")
  qtyReturnedBGrade  Decimal  @default(0) @db.Decimal(15, 4) @map("qty_returned_b_grade")
  bUnitValue         Decimal  @db.Decimal(15, 4) @map("b_unit_value")
  aFinalUnitCost     Decimal  @db.Decimal(15, 4) @map("a_final_unit_cost")
  createdAt          DateTime @default(now()) @map("created_at")

  order           BGradeRefreshOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  item            Item @relation("BGradeRefreshOrderItems", fields: [itemId], references: [id])
  receivingItems  BGradeRefreshReceivingItem[]

  @@index([orderId])
  @@index([itemId])
  @@map("b_grade_refresh_order_items")
}

model BGradeRefreshReceiving {
  id                String   @id @default(uuid())
  receivingNumber   String   @unique @map("receiving_number")
  orderId           String   @map("order_id")
  supplierId        String   @map("supplier_id")
  aGradeWarehouseId String   @map("a_grade_warehouse_id")
  refreshCostPerPc  Decimal  @default(0) @db.Decimal(15, 4) @map("refresh_cost_per_pc")
  totalRefreshCost  Decimal  @default(0) @db.Decimal(15, 4) @map("total_refresh_cost")
  purchaseInvoiceId String?  @unique @map("purchase_invoice_id")
  receivedDate      DateTime @default(now()) @map("received_date")
  notes             String?
  createdAt         DateTime @default(now()) @map("created_at")

  order             BGradeRefreshOrder @relation(fields: [orderId], references: [id])
  supplier          Supplier @relation("SupplierBGradeRefreshReceivings", fields: [supplierId], references: [id])
  aGradeWarehouse   Warehouse @relation("BGradeRefreshReceivingWarehouse", fields: [aGradeWarehouseId], references: [id])
  purchaseInvoice   PurchaseInvoice? @relation("BGradeRefreshReceivingInvoice", fields: [purchaseInvoiceId], references: [id])
  items             BGradeRefreshReceivingItem[]

  @@index([orderId])
  @@map("b_grade_refresh_receivings")
}

model BGradeRefreshReceivingItem {
  id                 String   @id @default(uuid())
  receivingId        String   @map("receiving_id")
  orderItemId        String   @map("order_item_id")
  itemId             String   @map("item_id")
  qtyReceived        Decimal  @db.Decimal(15, 4) @map("qty_received")
  qtyReturnedBGrade  Decimal  @default(0) @db.Decimal(15, 4) @map("qty_returned_b_grade")
  refreshCostPerPc   Decimal  @default(0) @db.Decimal(15, 4) @map("refresh_cost_per_pc")
  bUnitValue         Decimal  @default(0) @db.Decimal(15, 4) @map("b_unit_value")
  createdAt          DateTime @default(now()) @map("created_at")

  receiving        BGradeRefreshReceiving @relation(fields: [receivingId], references: [id], onDelete: Cascade)
  orderItem        BGradeRefreshOrderItem @relation(fields: [orderItemId], references: [id])
  item             Item @relation("BGradeRefreshReceivingItems", fields: [itemId], references: [id])

  @@index([receivingId])
  @@index([orderItemId])
  @@map("b_grade_refresh_receiving_items")
}
